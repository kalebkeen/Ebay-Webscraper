<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark background matching the client's own palette, so there is no
         white flash between the splash and the WebView painting. -->
    <style name="Theme.Spine" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
