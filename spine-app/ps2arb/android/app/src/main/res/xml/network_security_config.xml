<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP by default, which would break the loopback
  server before the WebView ever loaded. This permits cleartext to localhost
  ONLY: everything outbound (eBay, PriceCharting) still requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
